{
 "vo_duration": 27.77,
 "phrases": [
  {
   "s": 0.095,
   "e": 1.775,
   "text": "Tu sais vraiment ce que tu respires chez toi ?"
  },
  {
   "s": 2.095,
   "e": 2.705,
   "text": "Regarde ça :"
  },
  {
   "s": 2.855,
   "e": 4.145,
   "text": "la Temtop W100 !"
  },
  {
   "s": 4.385,
   "e": 5.365,
   "text": "Une station météo"
  },
  {
   "s": 5.545,
   "e": 7.115,
   "text": "ET un moniteur de qualité de l'air,"
  },
  {
   "s": 7.255,
   "e": 8.355,
   "text": "dans un seul appareil."
  },
  {
   "s": 8.635,
   "e": 9.965,
   "text": "Dehors, elle mesure le vent,"
  },
  {
   "s": 10.095,
   "e": 10.595,
   "text": "la pluie,"
  },
  {
   "s": 10.745,
   "e": 11.275,
   "text": "les UV"
  },
  {
   "s": 11.385,
   "e": 12.275,
   "text": "et la luminosité."
  },
  {
   "s": 12.575,
   "e": 12.975,
   "text": "Dedans,"
  },
  {
   "s": 13.085,
   "e": 14.275,
   "text": "elle surveille le CO₂,"
  },
  {
   "s": 14.425,
   "e": 15.395,
   "text": "les particules fines,"
  },
  {
   "s": 15.545,
   "e": 16.205,
   "text": "et les COV,"
  },
  {
   "s": 16.395,
   "e": 17.095,
   "text": "en temps réel."
  },
  {
   "s": 17.375,
   "e": 19.595,
   "text": "Tout s'affiche sur un écran tactile de 7 pouces,"
  },
  {
   "s": 19.715,
   "e": 20.955,
   "text": "avec les prévisions météo."
  },
  {
   "s": 21.235,
   "e": 22.485,
   "text": "Si l'air devient trop chargé…"
  },
  {
   "s": 22.825,
   "e": 23.475,
   "text": "elle t'alerte."
  },
  {
   "s": 23.755,
   "e": 25.045,
   "text": "Et tu suis tout depuis l'appli,"
  },
  {
   "s": 25.235,
   "e": 26.125,
   "text": "même quand t'es pas là."
  },
  {
   "s": 26.405,
   "e": 27.73,
   "text": "Je te mets le lien juste en dessous !"
  }
 ],
