{"duration": 31.653, "segments": [{"id": "s01", "text": "Ils ont écrit vingt-cinq mille pascals sur ma boîte. En énorme.", "start": 0.12, "end": 3.79, "display": "Ils ont écrit 25 000 Pa sur ma boîte. | En énorme.", "words": [[0.14, 0.369, "Ils"], [0.369, 0.598, "ont"], [0.598, 1.196, "écrit"], [1.196, 2.113, "25 000 Pa"], [2.113, 2.342, "sur"], [2.342, 2.571, "ma"], [2.82, 2.93, "boîte."], [3.14, 3.14, "|"], [3.14, 3.353, "En"], [3.353, 3.78, "énorme."]]}, {"id": "s02", "text": "Mais le pascal, ça mesure une pression. Ça ne suffit pas à dire si ton sol sera propre.", "start": 3.89, "end": 9.213, "display": "Mais le pascal, ça mesure une pression. | Ça ne suffit pas à dire si ton sol sera propre.", "words": [[3.92, 4.118, "Mais"], [4.118, 4.315, "le"], [4.315, 4.71, "pascal,"], [5.14, 5.257, "ça"], [5.257, 5.63, "mesure"], [5.63, 5.817, "une"], [5.817, 6.19, "pression."], [6.37, 6.37, "|"], [6.37, 6.566, "Ça"], [6.566, 6.762, "ne"], [6.762, 7.155, "suffit"], [7.155, 7.351, "pas"], [7.351, 7.547, "à"], [7.547, 7.743, "dire"], [7.743, 7.939, "si"], [7.939, 8.135, "ton"], [8.135, 8.332, "sol"], [8.332, 8.824, "sera"], [9.04, 9.21, "propre."]]}, {"id": "s03", "text": "Et ce chiffre, c'est mon mode maximum. Pas forcément celui que tu utilises tous les jours.", "start": 9.313, "end": 15.423, "display": "Et ce chiffre, c'est mon mode maximum. | Pas forcément celui que tu utilises tous les jours.", "words": [[9.34, 9.607, "Et"], [9.607, 9.873, "ce"], [9.873, 10.14, "chiffre,"], [10.55, 10.976, "c'est"], [10.976, 11.189, "mon"], [11.189, 11.401, "mode"], [11.401, 12.22, "maximum."], [12.34, 12.34, "|"], [12.34, 12.562, "Pas"], [12.562, 13.005, "forcément"], [13.005, 13.448, "celui"], [13.448, 13.669, "que"], [13.669, 13.891, "tu"], [13.891, 14.555, "utilises"], [14.555, 14.947, "tous"], [14.947, 15.168, "les"], [15.168, 15.39, "jours."]]}, {"id": "s04", "text": "Une testeuse de Tèk Radar l'a vu : les chiffres explosent, le nettoyage, pas autant.", "start": 15.523, "end": 21.26, "display": "Une testeuse de TechRadar l'a vu : | les chiffres explosent, | le nettoyage, pas autant.", "words": [[15.55, 15.756, "Une"], [15.756, 16.168, "testeuse"], [16.168, 16.374, "de"], [16.6, 17.142, "TechRadar"], [17.142, 17.554, "l'a"], [17.554, 17.76, "vu :"], [17.9, 17.9, "|"], [17.9, 18.308, "les"], [18.308, 18.715, "chiffres"], [18.715, 19.53, "explosent,"], [19.64, 19.64, "|"], [19.64, 19.855, "le"], [19.855, 20.285, "nettoyage,"], [20.285, 20.5, "pas"], [20.83, 21.24, "autant."]]}, {"id": "s05", "text": "Pour elle, dix mille pascals, c'est déjà largement assez pour bien nettoyer.", "start": 21.36, "end": 25.73, "display": "Pour elle, 10 000 Pa, | c'est déjà largement assez pour bien nettoyer.", "words": [[21.39, 21.645, "Pour"], [21.645, 21.9, "elle,"], [22.1, 23.13, "10 000 Pa,"], [23.53, 23.53, "|"], [23.53, 23.893, "c'est"], [23.893, 24.257, "déjà"], [24.257, 24.62, "largement"], [24.62, 24.983, "assez"], [24.983, 25.165, "pour"], [25.165, 25.347, "bien"], [25.347, 25.71, "nettoyer."]]}, {"id": "s06", "text": "Regarde aussi ma brosse et ma navigation.", "start": 25.83, "end": 28.105, "display": "Regarde aussi ma brosse et ma navigation.", "words": [[25.85, 26.198, "Regarde"], [26.198, 26.547, "aussi"], [26.547, 26.721, "ma"], [26.721, 26.895, "brosse"], [26.895, 27.069, "et"], [27.26, 27.383, "ma"], [27.383, 28.08, "navigation."]]}, {"id": "s07", "text": "Abonne-toi : d'autres objets vont tout balancer.", "start": 28.205, "end": 31.353, "display": "Abonne-toi : d'autres objets vont tout balancer.", "words": [[28.22, 28.86, "Abonne-toi :"], [29.02, 29.464, "d'autres"], [29.464, 29.909, "objets"], [29.909, 30.131, "vont"], [30.131, 30.353, "tout"], [30.353, 31.33, "balancer."]]}], "mouth": {"fps": 30, "v": [0.0, 0.0, 0.0, 0.0, 0.094, 0.791, 0.918, 0.916, 0.862, 0.788, 0.398, 0.583, 0.825, 0.701, 0.245, 0.761, 0.61, 0.725, 0.576, 0.713, 0.617, 0.473, 0.326, 0.14, 0.049, 0.017, 0.006, 0.002, 0.001, 0.031, 0.477, 0.998, 0.911, 0.508, 0.296, 0.252, 0.