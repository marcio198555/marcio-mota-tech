{"duration": 25.724, "segments": [{"id": "s01", "text": "Ils ont écrit vingt-cinq mille pascals sur ma boîte. En énorme.", "start": 0.107, "end": 3.616, "display": "Ils ont écrit 25 000 Pa sur ma boîte. | En énorme.", "words": [[0.13, 0.356, "Ils"], [0.356, 0.583, "ont"], [0.583, 1.035, "écrit"], [1.035, 1.941, "25 000 Pa"], [1.941, 2.167, "sur"], [2.167, 2.394, "ma"], [2.394, 2.62, "boîte."], [2.76, 2.76, "|"], [2.76, 3.043, "En"], [3.043, 3.61, "énorme."]]}, {"id": "s02", "text": "Mais le pascal, ça mesure une pression. Ça ne suffit pas à dire si ton sol sera propre.", "start": 3.705, "end": 8.637, "display": "Mais le pascal, ça mesure une pression. | Ça ne suffit pas à dire si ton sol sera propre.", "words": [[3.71, 3.978, "Mais"], [3.978, 4.245, "le"], [4.245, 4.78, "pascal,"], [4.96, 5.14, "ça"], [5.14, 5.5, "mesure"], [5.5, 5.68, "une"], [5.68, 6.04, "pression."], [6.33, 6.33, "|"], [6.33, 6.506, "Ça"], [6.506, 6.682, "ne"], [6.682, 7.035, "suffit"], [7.035, 7.211, "pas"], [7.211, 7.387, "à"], [7.387, 7.563, "dire"], [7.563, 7.739, "si"], [7.739, 7.915, "ton"], [7.915, 8.092, "sol"], [8.092, 8.444, "sera"], [8.444, 8.62, "propre."]]}, {"id": "s03", "text": "Et ce chiffre, c'est mon mode maximum. Pas forcément celui que tu utilises tous les jours.", "start": 8.726, "end": 13.271, "display": "Et ce chiffre, c'est mon mode maximum. | Pas forcément celui que tu utilises tous les jours.", "words": [[8.75, 8.943, "Et"], [8.943, 9.136, "ce"], [9.136, 9.329, "chiffre,"], [9.329, 9.715, "c'est"], [9.715, 9.908, "mon"], [9.908, 10.101, "mode"], [10.101, 10.68, "maximum."], [11.1, 11.1, "|"], [11.1, 11.265, "Pas"], [11.265, 11.596, "forcément"], [11.596, 11.927, "celui"], [11.927, 12.092, "que"], [12.092, 12.258, "tu"], [12.258, 12.754, "utilises"], [12.754, 12.919, "tous"], [12.919, 13.085, "les"], [13.085, 13.25, "jours."]]}, {"id": "s04", "text": "Une testeuse de Tèk Radar l'a vu : les chiffres explosent, le nettoyage, pas autant.", "start": 13.36, "end": 17.584, "display": "Une testeuse de TechRadar l'a vu : | les chiffres explosent, | le nettoyage, pas autant.", "words": [[13.38, 13.532, "Une"], [13.532, 13.836, "testeuse"], [13.836, 13.988, "de"], [13.988, 14.444, "TechRadar"], [14.444, 14.748, "l'a"], [14.748, 14.9, "vu :"], [15.16, 15.16, "|"], [15.16, 15.438, "les"], [15.438, 15.715, "chiffres"], [15.715, 16.27, "explosent,"], [16.38, 16.38, "|"], [16.38, 16.61, "le"], [16.61, 17.07, "nettoyage,"], [17.17, 17.3, "pas"], [17.3, 17.56, "autant."]]}, {"id": "s05", "text": "Pour elle, dix mille pascals, c'est déjà largement assez pour bien nettoyer.", "start": 17.673, "end": 21.279, "display": "Pour elle, 10 000 Pa, | c'est déjà largement assez pour bien nettoyer.", "words": [[17.7, 17.909, "Pour"], [17.909, 18.119, "elle,"], [18.119, 18.747, "10 000 Pa,"], [18.747, 18.747, "|"], [18.747, 19.166, "c'est"], [19.166, 19.585, "déjà"], [19.585, 20.004, "largement"], [20.004, 20.422, "assez"], [20.422, 20.632, "pour"], [20.632, 20.841, "bien"], [20.841, 21.26, "nettoyer."]]}, {"id": "s06", "text": "Regarde aussi ma brosse et ma navigation.", "start": 21.368, "end": 23.285, "display": "Regarde aussi ma brosse et ma navigation.", "words": [[21.39, 21.702, "Regarde"], [21.702, 22.013, "aussi"], [22.013, 22.169, "ma"], [22.169, 22.325, "brosse"], [22.325, 22.481, "et"], [22.481, 22.637, "ma"], [22.637, 23.26, "navigation."]]}, {"id": "s07", "text": "Abonne-toi : d'autres objets vont tout balancer.", "start": 23.374, "end": 25.456, "display": "Abonne-toi : d'autres objets vont tout balancer.", "words": [[23.4, 23.98, "Abonne-toi :"], [24.14, 24.427, "d'autres"], [24.427, 24.713, "objets"], [24.713, 24.857, "vont"], [24.857, 25.0, "tout"], [25.0, 25.43, "balancer."]]}], "voice_fx": 1.12, "mouth": {"fps": 30, "v": [0.0, 0.0, 0.0, 0.0, 0.647, 0.785, 0.718, 0.657, 0.975, 0.934, 0.884, 0.807, 0.808, 0.376, 0.132, 0.763, 0.957, 0.335, 0.702, 0.781, 0.852, 0.582, 0.59, 0.664, 0.677, 0.48, 0.212, 0.43, 0.792, 0.858, 0.728, 0.255, 0.171, 0.803, 